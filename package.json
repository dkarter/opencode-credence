{
  "name": "opencode-credence",
  "version": "0.1.0",
  "description": "Run Credence on changed Elixir files when an opencode session goes idle.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "credence",
    "elixir"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.50",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
